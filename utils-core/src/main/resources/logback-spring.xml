<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender (human readable) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Allow per-module overrides (override with -Dlogging.config=file:/path/logback-spring-extra.xml) -->
    <include optional="true" resource="logback-spring-extra.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>