<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.manage.mapper.RoleModuleMapper">

    <resultMap id="roleModuleResultMap" type="com.backend.manage.entity.RoleModuleEntity">
        <id property="id" column="id"/>
        <result property="roleId" column="role_id"/>
        <result property="moduleId" column="module_id"/>
        <result property="canRead" column="can_read"/>
        <result property="canWrite" column="can_write"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByRoleId" resultMap="roleModuleResultMap">
        SELECT id, role_id, module_id, can_read, can_write, created_at
        FROM role_module
        WHERE role_id = #{roleId}
    </select>

    <select id="findModuleIdsByRoleId" resultType="long">
        SELECT module_id FROM role_module
        WHERE role_id = #{roleId}
    </select>

    <insert id="insert" parameterType="com.backend.manage.entity.RoleModuleEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO role_module (role_id, module_id, can_read, can_write, created_at)
        VALUES (#{roleId}, #{moduleId}, #{canRead}, #{canWrite}, NOW())
    </insert>

    <insert id="batchInsert">
        INSERT INTO role_module (role_id, module_id, can_read, can_write, created_at)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.moduleId}, #{item.canRead}, #{item.canWrite}, NOW())
        </foreach>
    </insert>

    <delete id="deleteByRoleId">
        DELETE FROM role_module WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteByModuleId">
        DELETE FROM role_module WHERE module_id = #{moduleId}
    </delete>

</mapper>