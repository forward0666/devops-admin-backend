<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.cloudflare.mapper.CfCacheRuleMapper">

    <resultMap id="CfCacheRuleResultMap" type="com.backend.cloudflare.entity.CfCacheRuleEntity">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="env" column="env"/>
        <result property="name" column="name"/>
        <result property="url" column="url"/>
        <result property="type" column="type"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByProjectId" resultMap="CfCacheRuleResultMap">
        SELECT * FROM cf_cache_rule WHERE project_id = #{projectId} ORDER BY id DESC
    </select>

    <select id="findByProjectIdAndEnv" resultMap="CfCacheRuleResultMap">
        SELECT * FROM cf_cache_rule WHERE project_id = #{projectId} AND env = #{env} ORDER BY id DESC
    </select>

    <select id="findById" resultMap="CfCacheRuleResultMap">
        SELECT * FROM cf_cache_rule WHERE id = #{id}
    </select>

    <select id="findDuplicateName" resultMap="CfCacheRuleResultMap">
        SELECT id FROM cf_cache_rule
        WHERE project_id = #{projectId} AND name = #{name} AND env = #{env}
        <if test="excludeId != null">AND id != #{excludeId}</if>
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.backend.cloudflare.entity.CfCacheRuleEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cf_cache_rule (project_id, env, name, url, type, created_at, updated_at)
        VALUES (#{projectId}, #{env}, #{name}, #{url}, #{type}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.backend.cloudflare.entity.CfCacheRuleEntity">
        UPDATE cf_cache_rule
        <set>
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="env != null">env = #{env},</if>
            <if test="name != null">name = #{name},</if>
            <if test="url != null">url = #{url},</if>
            <if test="type != null">type = #{type},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM cf_cache_rule WHERE id = #{id}
    </delete>

</mapper>