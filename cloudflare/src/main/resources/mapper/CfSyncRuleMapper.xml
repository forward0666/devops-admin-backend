<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.cloudflare.mapper.CfSyncRuleMapper">

    <resultMap id="CfSyncRuleResultMap" type="com.backend.cloudflare.entity.CfSyncRuleEntity">
        <id property="id" column="id"/>
        <result property="accountId" column="account_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="sourceZoneId" column="source_zone_id"/>
        <result property="targetZoneIds" column="target_zone_ids"/>
        <result property="ruleTypes" column="rule_types"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="lastSyncedAt" column="last_synced_at"/>
    </resultMap>

    <select id="findAll" resultMap="CfSyncRuleResultMap">
        SELECT * FROM cf_sync_rule ORDER BY created_at DESC
    </select>

    <select id="findByAccountId" resultMap="CfSyncRuleResultMap">
        SELECT * FROM cf_sync_rule WHERE account_id = #{accountId} ORDER BY created_at DESC
    </select>

    <select id="findById" resultMap="CfSyncRuleResultMap">
        SELECT * FROM cf_sync_rule WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.backend.cloudflare.entity.CfSyncRuleEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cf_sync_rule (account_id, name, description, source_zone_id, target_zone_ids, rule_types, created_at, updated_at)
        VALUES (#{accountId}, #{name}, #{description}, #{sourceZoneId}, #{targetZoneIds}, #{ruleTypes}, UTC_TIMESTAMP(), UTC_TIMESTAMP())
    </insert>

    <update id="update" parameterType="com.backend.cloudflare.entity.CfSyncRuleEntity">
        UPDATE cf_sync_rule
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sourceZoneId != null">source_zone_id = #{sourceZoneId},</if>
            <if test="targetZoneIds != null">target_zone_ids = #{targetZoneIds},</if>
            <if test="ruleTypes != null">rule_types = #{ruleTypes},</if>
            updated_at = UTC_TIMESTAMP()
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateLastSyncedAt">
        UPDATE cf_sync_rule SET last_synced_at = UTC_TIMESTAMP() WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM cf_sync_rule WHERE id = #{id}
    </delete>

</mapper>