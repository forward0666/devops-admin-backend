{
  "findByProjectId": {
    "collection": "middleware",
    "filter": [
      { "field": "projectId", "operator": "is", "param": "projectId" }
    ],
    "sort": { "createdAt": -1 }
  },
  "findById": {
    "collection": "middleware",
    "filter": [
      { "field": "_id", "operator": "is", "param": "id" }
    ]
  },
  "findByIdAndProjectId": {
    "collection": "middleware",
    "filter": [
      { "field": "_id", "operator": "is", "param": "id" },
      { "field": "projectId", "operator": "is", "param": "projectId" }
    ]
  }
}
