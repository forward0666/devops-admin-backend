<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.user.mapper.ProjectMapper">

    <resultMap id="ProjectResultMap" type="com.backend.user.entity.ProjectEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="progress" column="progress"/>
        <result property="departmentId" column="department_id"/>
        <result property="description" column="description"/>
        <result property="techStack" column="tech_stack"/>
        <result property="objectives" column="objectives"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="active" column="active"/>
    </resultMap>

    <select id="findAll" resultMap="ProjectResultMap">
        SELECT * FROM project WHERE active = true ORDER BY created_at DESC
    </select>

    <select id="findById" parameterType="long" resultMap="ProjectResultMap">
        SELECT * FROM project WHERE id = #{id} AND active = true
    </select>

</mapper>
