<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.login.mapper.UserMapper">

    <!-- ================= ResultMap ================= -->
    <resultMap id="UserResultMap" type="com.backend.login.entity.UserEntity">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="tgUsername" column="tg_username"/>
        <result property="fullName" column="full_name"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="departmentId" column="department_id"/>
        <result property="position" column="position"/>
        <result property="employeeId" column="employee_id"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="active" column="active"/>
        <result property="emailVerified" column="email_verified"/>
        <result property="phoneVerified" column="phone_verified"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="lastLoginIp" column="last_login_ip"/>
        <result property="loginCount" column="login_count"/>
        <result property="passwordChangedAt" column="password_changed_at"/>
        <result property="source" column="source"/>
    </resultMap>

    <!-- ================= 查询 ================= -->

    <select id="findByUsername" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE username = #{username}
          AND active = true
    </select>

    <select id="findById" parameterType="long" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE id = #{id}
          AND active = true
    </select>

    <select id="findByIdIncludeInactive" parameterType="long" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="UserResultMap">
        SELECT *
        FROM user
        ORDER BY created_at DESC
    </select>

    <select id="authenticate" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE username = #{username}
          AND active = true
    </select>

    <select id="findByDepartmentId" parameterType="long" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE department_id = #{departmentId}
          AND active = true
        ORDER BY created_at DESC
    </select>

    <!-- ================= 插入（核心修复） ================= -->

    <insert id="insert"
            parameterType="com.backend.login.entity.UserEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO user (
            username,
            password,
            email,
            phone,
            tg_username,
            source,
            full_name,
            avatar_url,
            department_id,
            position,
            employee_id,
            role,
            created_by,
            updated_by,
            active,
            email_verified,
            phone_verified,
            login_count,
            password_changed_at
        )
        VALUES (
                   #{username},
                   #{password},
                   NULLIF(#{email}, ''),
                   NULLIF(#{phone}, ''),
                   NULLIF(#{tgUsername}, ''),
                   #{source},
                   #{fullName},
                   #{avatarUrl},
                   #{departmentId},
                   #{position},
                   NULLIF(#{employeeId}, ''),
                   #{role},
                   #{createdBy},
                   #{updatedBy},
                   #{active},
                   #{emailVerified},
                   #{phoneVerified},
                   #{loginCount},
                   #{passwordChangedAt}
               )
    </insert>

    <!-- ================= 更新（核心修复） ================= -->

    <update id="update" parameterType="com.backend.login.entity.UserEntity">
        UPDATE user
        SET
            username        = #{username},
            email           = NULLIF(#{email}, ''),
            phone           = NULLIF(#{phone}, ''),
            tg_username     = NULLIF(#{tgUsername}, ''),
            full_name       = #{fullName},
            avatar_url      = #{avatarUrl},
            department_id   = #{departmentId},
            position        = #{position},
            employee_id     = NULLIF(#{employeeId}, ''),
            role            = #{role},
            updated_by      = #{updatedBy},
            active          = #{active},
            email_verified  = #{emailVerified},
            phone_verified  = #{phoneVerified}
        WHERE id = #{id}
    </update>

    <!-- ================= 其他更新 ================= -->

    <update id="updatePassword">
        UPDATE user
        SET password = #{password},
            password_changed_at = CURRENT_TIMESTAMP,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updateLoginInfo">
        UPDATE user
        SET last_login_at = #{lastLoginAt},
            last_login_ip = #{lastLoginIp},
            login_count = login_count + 1,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ================= 删除 ================= -->

    <delete id="deleteById" parameterType="long">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- ================= 存在性校验（NULL 安全） ================= -->

    <select id="existsById" parameterType="long" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE id = #{id}
          AND active = true
    </select>

    <select id="existsByUsername" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE username = #{username}
          AND active = true
    </select>

    <select id="existsByEmail" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE active = true
        <if test="email != null and email != ''">
            AND email = #{email}
        </if>
    </select>

    <select id="existsByPhone" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE active = true
        <if test="phone != null and phone != ''">
            AND phone = #{phone}
        </if>
    </select>

    <select id="existsByTgUsername" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE active = true
        <if test="tgUsername != null and tgUsername != ''">
            AND tg_username = #{tgUsername}
        </if>
    </select>

    <select id="existsByEmployeeId" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE active = true
        <if test="employeeId != null and employeeId != ''">
            AND employee_id = #{employeeId}
        </if>
    </select>

    <select id="countByDepartmentId" parameterType="long" resultType="int">
        SELECT COUNT(*)
        FROM user
        WHERE department_id = #{departmentId}
          AND active = true
    </select>

    <!-- ================= 搜索 ================= -->

    <select id="searchByUsernameOrEmail" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE active = true
          AND (
            username LIKE CONCAT('%', #{query}, '%')
                OR email LIKE CONCAT('%', #{query}, '%')
                OR phone LIKE CONCAT('%', #{query}, '%')
                OR tg_username LIKE CONCAT('%', #{query}, '%')
            )
        ORDER BY created_at DESC
    </select>

</mapper>
